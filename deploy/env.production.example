# Copy to backend/.env on the server, then: php artisan key:generate --force
APP_NAME=Ledger
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tbilisi
APP_URL=https://minder.ge
FRONTEND_URL=https://minder.ge

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ledger
DB_USERNAME=ledger
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=minder.ge
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=minder.ge,www.minder.ge

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Reminder e-mails (SendDueReminders runs every minute via schedule:run)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@minder.ge
MAIL_FROM_NAME="${APP_NAME}"

# OAuth — redirect URIs registered with the providers:
#   https://minder.ge/auth/google/callback
#   https://minder.ge/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
